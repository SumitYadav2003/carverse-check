# Copy to .env and fill in. .env is never committed.

# Local development: DJANGO_DEBUG=1. On Render: leave it out (debug stays off).
DJANGO_DEBUG=1
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Comma-separated. On Render: your-app.onrender.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# On Render: https://your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Neon Postgres connection string on Render. Leave empty locally to use SQLite.
DATABASE_URL=

# DVSA MOT history API (from DVSA's approval email). Leave empty to use sample cars only.
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_SCOPE=
DVSA_TOKEN_URL=

# Optional. Limits that protect the DVSA quota (defaults: 20 and 300).
# PLATE_LOOKUPS_PER_MINUTE=20
# DVSA_CALLS_PER_MINUTE=300

# Optional. Email yourself when the live site hits an unexpected error (500).
# Any SMTP service works, for example Brevo: EMAIL_HOST=smtp-relay.brevo.com
DJANGO_ADMIN_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# The sender address (must be one your email service lets you send from)
EMAIL_FROM=
