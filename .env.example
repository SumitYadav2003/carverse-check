# Copy to .env and fill in. .env is never committed.

# Local development: DJANGO_DEBUG=1. On Render: leave it out (debug stays off).
DJANGO_DEBUG=1
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Comma-separated. On Render: your-app.onrender.com
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# On Render: https://your-app.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Neon Postgres connection string on Render. Leave empty locally to use SQLite.
DATABASE_URL=

# DVSA MOT history API (from DVSA's approval email). Leave empty to use sample cars only.
DVSA_CLIENT_ID=
DVSA_CLIENT_SECRET=
DVSA_API_KEY=
DVSA_SCOPE=
DVSA_TOKEN_URL=
